  "license": "CC0 (assets from polyhaven.com)",
  "description": "Curated library of PBR textures + HDRIs for Three.js / R3F / Babylon. All assets CC0 from Polyhaven, referenced by URL (no local download required).",
  "cdn": {
    "textures": "https://dl.polyhaven.org/file/ph-assets/Textures/jpg/{res}/{name}/{name}_{map}_{res}.jpg",
    "hdris": "https://dl.polyhaven.org/file/ph-assets/HDRIs/hdr/{res}/{name}_{res}.hdr"
  },
  "maps_available": {
    "diff": "Albedo / color map (sRGB)",
    "nor_gl": "Normal map (OpenGL convention — Three.js, Babylon)",
    "nor_dx": "Normal map (DirectX convention — Unity)",
    "rough": "Roughness map (linear)",
    "ao": "Ambient occlusion map (linear)",
    "disp": "Displacement / height map (linear)",
    "arm": "Combined AO/Roughness/Metalness (linear, R=AO G=Rough B=Metal)"
  },
  "resolutions": ["1k", "2k", "4k"],
